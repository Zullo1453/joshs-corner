# Josh's Corner reads DATABASE_URL from the environment. Leave it empty to use
# the local SQLite database.
DATABASE_URL=

# Set a strong value outside source control before a hosted deployment.
FLASK_SECRET_KEY=

# Reserved for the approved Stage 2B Supabase integration. These values are
# intentionally blank and are not used by the app yet.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_STORAGE_BUCKET=
